<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ringfour_agent</name>
  <version>0.1.0</version>
  <description>
    The ringfour agent: a robot-agnostic ROS2 node that exposes the robot
    over JSON-RPC/WebSocket to the pure-Python ringfour client SDK.
    Contains zero robot-specific code; robot specifics arrive via profile
    YAML only.
  </description>
  <maintainer email="cristidragomir97@gmail.com">Cristi Dragomir</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>tf2_ros_py</depend>

  <!-- Interfaces the bridge speaks. slam_toolbox is here for its four .srv
       definitions only; the node itself runs in the robot's SLAM container,
       and the release image builds the interfaces without it (see
       docker/slam_toolbox_shim). -->
  <depend>action_msgs</depend>
  <depend>control_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>slam_toolbox</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- NOT rosdep keys, on purpose. The agent needs pydantic>=2.5 and
       websockets>=12; Ubuntu 24.04 ships 1.10 and 10.4, so python3-pydantic
       and python3-websockets are the wrong packages, not merely old ones.
       pip installs them (docker/Dockerfile), together with the `ringfour`
       SDK from this monorepo — `pip install <repo>/ringfour-sdk`. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
